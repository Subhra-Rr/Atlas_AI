# GEMINI_API_KEY: Required for Ask Atlas AI agent and server-side geospatial reasoning.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection string for production PostGIS.
# If omitted or unavailable, the system runs with the internal high-performance EngineDatabaseAdapter.
# Example: postgres://atlas_user:password@localhost:5432/atlasai
DATABASE_URL=""

# SESSION_SECRET / JWT_SECRET: Secret for signing JWT authentication and session tokens.
SESSION_SECRET="atlasai-secure-session-key-change-in-production"
JWT_SECRET="TaXw9sszBAajirtVAowcPYU0eAXfB2w0U+D4SmkVvvg="

# NODE_ENV: 'development' or 'production'
NODE_ENV="development"
